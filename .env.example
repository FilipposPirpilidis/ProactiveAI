OLLAMA_BASE_URL=http://192.168.68.112:11434
OLLAMA_MODEL=glm-5.3-flash:cloud
# Proactive AI v2 uses separate trigger and insight stages. Leave these blank
# to inherit OLLAMA_BASE_URL and OLLAMA_MODEL above.
TRIGGER_OLLAMA_BASE_URL=
TRIGGER_OLLAMA_MODEL=
TRIGGER_OLLAMA_TIMEOUT_SECONDS=20
INSIGHT_OLLAMA_BASE_URL=
INSIGHT_OLLAMA_MODEL=
INSIGHT_OLLAMA_TIMEOUT_SECONDS=30
# Default credentials work immediately; change the password before deployment.
AUTH_USERNAME=homebuddy
AUTH_PASSWORD=123456
# Optional pre-shared bearer token for clients that cannot perform sign-in.
AUTH_STATIC_TOKEN=
AUTH_TOKEN_TTL_SECONDS=86400
DETECTOR_MODE=conversate
# The mounted Markdown file controls language policy and trusted insight instructions.
CONVERSATE_RULES_PATH=/config/conversate-rules.md
# Wait briefly for rapidly changing STT partials to settle before evaluating the newest one.
PARTIAL_INSIGHT_DEBOUNCE_MS=650
# Minimum start-to-start interval between partial evaluations during continuous speech.
PARTIAL_INSIGHT_INTERVAL_MS=2000
# Low-priority partial cards may recur sooner than final-transcript cards.
PARTIAL_INSIGHT_COOLDOWN_SECONDS=12
# Partials are noisy: wait for enough words and require high model confidence.
PARTIAL_INSIGHT_MIN_WORDS=7
PARTIAL_INSIGHT_MIN_CONFIDENCE=0.85
# Discard a result when newer speech replaces it or generation takes too long.
PARTIAL_INSIGHT_MAX_AGE_SECONDS=8
FINAL_INSIGHT_MAX_AGE_SECONDS=30
# A second, slower lane reasons over the active multi-turn topic.
TOPIC_OBSERVER_ENABLED=true
TOPIC_OBSERVER_DEBOUNCE_MS=4000
TOPIC_OBSERVER_INTERVAL_MS=8000
TOPIC_OBSERVER_MIN_WORDS=35
TOPIC_OBSERVER_MIN_CONFIDENCE=0.86
TOPIC_OBSERVER_MAX_AGE_SECONDS=90
TOPIC_OBSERVER_CONTEXT_ITEMS=24
TRANSCRIPT_WINDOW_SECONDS=180
# Soft glasses-card length target and hard UI safety ceiling.
INSIGHT_TARGET_CHARACTERS=260
INSIGHT_MAX_CHARACTERS=340
SESSION_ANALYSIS_MAX_CHARACTERS=60000
LOG_LEVEL=INFO
