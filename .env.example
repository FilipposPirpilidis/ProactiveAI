OLLAMA_BASE_URL=http://192.168.68.112:11434
OLLAMA_MODEL=qwen3.5:cloud
# Default credentials work immediately; change the password before deployment.
AUTH_USERNAME=homebuddy
AUTH_PASSWORD=123456
AUTH_TOKEN_TTL_SECONDS=86400
DETECTOR_MODE=conversate
# Wait briefly for rapidly changing STT partials to settle before evaluating the newest one.
PARTIAL_INSIGHT_DEBOUNCE_MS=250
# Minimum start-to-start interval between partial evaluations during continuous speech.
PARTIAL_INSIGHT_INTERVAL_MS=1500
# Low-priority partial cards may recur sooner than final-transcript cards.
PARTIAL_INSIGHT_COOLDOWN_SECONDS=6
# Soft glasses-card length target and hard UI safety ceiling.
INSIGHT_TARGET_CHARACTERS=150
INSIGHT_MAX_CHARACTERS=220
SESSION_ANALYSIS_MAX_CHARACTERS=60000
LOG_LEVEL=INFO
